{
  "scripts": [
    {
      "url_pattern": "*",
      "inject": "inject/全局.js"
    },
    {
      "url_pattern": "*.zhihu.com/*",
      "inject": "inject/知乎.js"
    },
    {
      "url_pattern": "*.feishu.cn/wiki/*",
      "inject": "inject/飞书wiki.js"
    },
    {
      "url_pattern": "*.feishu.cn/docx/*",
      "inject": "inject/飞书wiki.js"
    },
    {
      "url_pattern": "bytedance.larkoffice.com/docx/*",
      "inject": "inject/飞书wiki.js"
    },
    {
      "url_pattern": "bytedance.larkoffice.com/wiki/*",
      "inject": "inject/飞书wiki.js"
    },
    {
      "url_pattern": "*://127.0.0.1:*/*",
      "inject": "inject/思源.js"
    },
    {
      "url_pattern": "*://localhost:*/*",
      "inject": "inject/思源.js"
    },
    {
      "url_pattern": "*.xiaohongshu.com/*",
      "inject": "inject/小红书.js"
    },
    {
      "url_pattern": "*.xiaohongshu.com/user/profile/*",
      "inject": "inject/小红书-feed.js"
    }
  ]
}
